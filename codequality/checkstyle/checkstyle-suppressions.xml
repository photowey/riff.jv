<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <suppress files="[\\/].*(package-info)\.java" checks="RegexpOnFilename"/>

    <suppress files=".*[\\/]model[\\/]query[\\/]pagination([\\/])?.*" checks="RegexpOnFilename"/>
    <suppress files=".*[\\/]service[\\/]listener([\\/])?.*" checks="RegexpOnFilename"/>
    <suppress files=".*[\\/]service[\\/]calculator([\\/])?.*" checks="RegexpOnFilename"/>

    <suppress files=".*[\\/]enums([\\/])?.*" checks="NoWhitespaceBefore"/>
    <suppress files=".*[\\/]constant([\\/])?.*" checks="InterfaceIsType"/>
    <suppress files=".*[\\/]common[\\/]json([\\/])?.*" checks="OverloadMethodsDeclarationOrder"/>

    <suppress files=".*[\\/]apiserver[\\/]ApiServer\.java" checks="UncommentedMain"/>
    <suppress files=".*[\\/]apiserver([\\/])?.*[\\/]Test.*\.java" checks="UncommentedMain"/>
    <suppress files=".*[\\/]job([\\/])?.*[\\/]Test.*\.java" checks="UncommentedMain"/>
</suppressions>

