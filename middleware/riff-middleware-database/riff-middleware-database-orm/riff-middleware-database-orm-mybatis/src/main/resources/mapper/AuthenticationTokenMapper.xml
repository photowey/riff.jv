<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace=".yzclouduavplatformbusinessorganization.repository.database.AuthenticationTokenRepository">

    <!--
    @author photowey
    @version 1.0.0
    @since 2025/07/21
    -->

    <!-- 物理删除 -->
    <delete id="physicalDelete">
        DELETE FROM riff_authentication_token WHERE id = #{id}
    </delete>

    <!--
    逻辑删除
    <update id="logicalDelete">
        UPDATE riff_authentication_token SET deleted = 1 WHERE id = #{id}
    </update>
    -->
</mapper>